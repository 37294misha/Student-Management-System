@model IEnumerable<Student_Management_System.Models.Student>

@{
    ViewBag.Title = "Student Management System";
}

<h2>Student Management System</h2>

<p>
    @Html.ActionLink("Add New Student", "Create", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Department</th>
            <th>Semester</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                    <td>@Html.DisplayFor(modelItem => item.Phone)</td>
                    <td>@Html.DisplayFor(modelItem => item.Department)</td>
                    <td>@Html.DisplayFor(modelItem => item.Semester)</td>
                    <td class="text-center">
                        @Html.ActionLink("Edit", "Edit", new { id = item.StudentId }, new { @class = "btn btn-sm btn-warning me-1" })|
                        @Html.ActionLink("Details", "Details", new { id = item.StudentId }, new { @class = "btn btn-sm btn-info text-white me-1" })|
                        @Html.ActionLink("Delete", "Delete", new { id = item.StudentId }, new { @class = "btn btn-sm btn-danger" })
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">No record found. Click 'Add New Student' to insert data.</td>
            </tr>
        }
    </tbody>
</table>