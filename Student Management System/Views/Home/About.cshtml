@{
    ViewBag.Title = "About Us";
}

<div class="container my-4">
    <div class="p-5 mb-4 bg-light rounded-3 border">
        <h1 class="display-5 fw-bold text-primary">Student Management System</h1>
        <p class="col-md-10 fs-5 mt-3">
            Welcome to the Student Management System. This platform is designed to simplify and streamline academic administration by providing an efficient, reliable, and user-friendly interface to manage student records.
        </p>
    </div>

    <div class="row g-4 my-2">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 bg-light">
                <div class="card-body">
                    <h5 class="card-title fw-bold text-dark">🎯 Mission</h5>
                    <p class="card-text">To digitize campus record-keeping, reduce manual paperwork, and provide seamless access to student data for educational institutions.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 bg-light">
                <div class="card-body">
                    <h5 class="card-title fw-bold text-dark">⚡ Key Features</h5>
                    <ul class="ps-3 mb-0">
                        <li>Student Registration & Profiles</li>
                        <li>Real-time Data Updates (CRUD)</li>
                        <li>Department & Semester Tracking</li>
                        <li>Centralized Database Storage</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 bg-light">
                <div class="card-body">
                    <h5 class="card-title fw-bold text-dark">🛠️ Technology Stack</h5>
                    <p class="card-text">
                        <strong>Framework:</strong> ASP.NET MVC 5<br />
                        <strong>ORM:</strong> Entity Framework 6<br />
                        <strong>Database:</strong> SQL Server<br />
                        <strong>UI:</strong> Bootstrap & Razor Views
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>