@{
    ViewBag.Title = "Contact Us";
}

<div class="container my-5">
    <!-- Hero Banner Section -->
    <div class="p-5 mb-5 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-primary px-3 py-2 mb-3 rounded-pill text-uppercase fw-bold">Support Center</span>
                <h1 class="display-5 fw-bold mb-3">We're Here to Help You</h1>
                <p class="fs-5 text-light opacity-75 mb-0">
                    Have questions about admissions, system access, or student records? Reach out to our dedicated support team.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                <a href="#contact-form" class="btn btn-primary btn-lg px-4 rounded-3 shadow-sm fw-bold">Send Message</a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Contact Cards Section -->
        <div class="col-lg-5">
            <div class="d-flex flex-column gap-3">

                <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                    <div class="card-body d-flex align-items-start gap-3">
                        <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3 fs-4">
                            📍
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark mb-1">Sofware House</h6>
                            <p class="text-muted small mb-0">CNS</p>
                            <p class="text-secondary small fw-semibold">i10/3, Islamabad, Pakistan</p>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                    <div class="card-body d-flex align-items-start gap-3">
                        <div class="p-3 bg-success bg-opacity-10 text-success rounded-3 fs-4">
                            📞
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark mb-1">Direct Phone Lines</h6>
                            <p class="text-muted small mb-0">Mon – Fri (09:00 AM – 05:00 PM)</p>
                            <p class="text-secondary small fw-semibold">+92 (51) 111-222-333</p>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                    <div class="card-body d-flex align-items-start gap-3">
                        <div class="p-3 bg-info bg-opacity-10 text-info rounded-3 fs-4">
                            ✉️
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark mb-1">Email Inquiries</h6>
                            <p class="text-muted small mb-0">Response within 24 business hours</p>
                            <p class="text-secondary small fw-semibold">mishanadeem100@gmail.com</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Professional Form Section -->
        <div class="col-lg-7" id="contact-form">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                <div class="card-body">
                    <h4 class="fw-bold text-dark mb-1">Send Us a Direct Message</h4>
                    <p class="text-muted small mb-4">Fill out the details below and our team will get back to you shortly.</p>

                   
                </div>
            </div>
        </div>
    </div>
</div>